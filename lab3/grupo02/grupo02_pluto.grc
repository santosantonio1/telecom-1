- name: quadros_rx
  id: epy_block
  parameters:
    _source_code: |
      """
      Receptor de quadros (RX) - Grupo 02

      Recebe os PDUs do 'Tagged Stream to PDU', desfaz o branqueamento, confere o
      CRC32 e conta quadros perdidos pelos saltos no numero de sequencia.
      A cada 'intervalo' segundos imprime: quadros/s, recebidos, perdidos (taxa),
      CRC ruim e a ultima mensagem recebida.
      """
      import struct
      import threading
      import time
      import zlib

      import numpy as np
      import pmt
      from gnuradio import gr

      TAM_PAYLOAD = 56
      BRANQUEAMENTO = np.random.default_rng(1).integers(0, 256, TAM_PAYLOAD, dtype=np.uint8)


      class blk(gr.basic_block):
          """Quadros RX: confere CRC, conta perdas e imprime mensagens"""

          def __init__(self, intervalo=1.0):
              gr.basic_block.__init__(self, name='Quadros RX', in_sig=None, out_sig=None)
              self.intervalo = intervalo
              self.message_port_register_in(pmt.intern('pdus'))
              self.set_msg_handler(pmt.intern('pdus'), self.trata)
              self.recebidos = self.perdidos = self.crc_ruim = 0
              self.ultimo_seq = None
              self.ultima_msg = ''
              self.rodando = False

          def trata(self, msg):
              b = np.array(pmt.u8vector_elements(pmt.cdr(msg)), np.uint8)
              if len(b) != TAM_PAYLOAD:
                  self.crc_ruim += 1
                  return
              b = (b ^ BRANQUEAMENTO).tobytes()
              if zlib.crc32(b[:-4]) != struct.unpack('>I', b[-4:])[0]:
                  self.crc_ruim += 1  # o quadro vira um salto de sequencia e conta como perdido
                  return
              seq = struct.unpack('>I', b[:4])[0]
              if self.ultimo_seq is not None:
                  salto = (seq - self.ultimo_seq - 1) & 0xFFFFFFFF
                  if salto < 100000:  # salto enorme = o transmissor reiniciou; so ressincroniza
                      self.perdidos += salto
              self.ultimo_seq = seq
              self.recebidos += 1
              self.ultima_msg = b[4:52].decode(errors='replace').rstrip()

          def start(self):
              self.rodando = True
              threading.Thread(target=self.relatorio, daemon=True).start()
              return True

          def stop(self):
              self.rodando = False
              return True

          def relatorio(self):
              anterior = 0
              while self.rodando:
                  time.sleep(self.intervalo)
                  r, p = self.recebidos, self.perdidos
                  taxa = 100.0 * p / (r + p) if r + p else 0.0
                  print(f'[RX] {(r - anterior) / self.intervalo:5.0f} quadros/s | recebidos {r} | '
                        f'perdidos {p} ({taxa:.2f} %) | CRC ruim {self.crc_ruim} | msg: "{self.ultima_msg}"',
                        flush=True)
                  anterior = r
    intervalo: '1.0'
    _io_cache: '(''Quadros RX'', ''blk'', [(''intervalo'', ''1.0'')], [(''pdus'', ''message'', 1)], [], ''Quadros RX: confere CRC, conta perdas e imprime mensagens'', [''intervalo''])'
