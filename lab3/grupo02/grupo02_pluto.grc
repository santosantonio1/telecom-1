- name: quadros_tx
  id: epy_block
  parameters:
    _source_code: |
      """
      Gerador de quadros (TX) - Grupo 02

      Quadro = codigo de acesso (64 bits) | comprimento (16 bits) x2 | payload
      payload (56 bytes, branqueado) = sequencia (32 bits) | texto (48 bytes) | CRC32

      A sequencia permite ao receptor contar quadros perdidos. O branqueamento
      (XOR com sequencia pseudoaleatoria fixa) evita longas repeticoes de simbolos
      que atrapalham a recuperacao de relogio e de frequencia.
      """
      import struct
      import zlib

      import numpy as np
      from gnuradio import gr

      CODIGO_ACESSO = '1010110011011101101001001110001011110010100011000010000011111100'
      TAM_PAYLOAD = 56
      BRANQUEAMENTO = np.random.default_rng(1).integers(0, 256, TAM_PAYLOAD, dtype=np.uint8)
      CABECALHO = np.frombuffer(int(CODIGO_ACESSO, 2).to_bytes(8, 'big') + struct.pack('>HH', TAM_PAYLOAD, TAM_PAYLOAD), np.uint8)


      class blk(gr.sync_block):
          """Quadros TX: gera quadros continuamente (bytes empacotados)"""

          def __init__(self, mensagem='Grupo 02 -> Grupo 01: ola!'):
              gr.sync_block.__init__(self, name='Quadros TX', in_sig=None, out_sig=[np.uint8])
              self.mensagem = mensagem
              self.seq = 0
              self.buf = np.zeros(0, np.uint8)

          def quadro(self):
              p = struct.pack('>I', self.seq) + self.mensagem.encode()[:48].ljust(48)
              p += struct.pack('>I', zlib.crc32(p))
              self.seq = (self.seq + 1) & 0xFFFFFFFF
              return np.concatenate([CABECALHO, np.frombuffer(p, np.uint8) ^ BRANQUEAMENTO])

          def work(self, input_items, output_items):
              out = output_items[0]
              while len(self.buf) < len(out):
                  self.buf = np.concatenate([self.buf, self.quadro()])
              out[:] = self.buf[:len(out)]
              self.buf = self.buf[len(out):]
              return len(out)
    mensagem: mensagem
    _io_cache: '(''Quadros TX'', ''blk'', [(''mensagem'', "''Grupo 02 -> Grupo 01: ola!''")], [], [(''0'', ''byte'', 1)], ''Quadros TX: gera quadros continuamente (bytes empacotados)'', [''mensagem''])'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 380
    rotation: 0
    state: enabled
